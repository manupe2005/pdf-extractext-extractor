# Configuración local: copiar a .env y ajustar según el entorno.
APP_NAME=pdf-extractext-extractor
APP_VERSION=0.1.0
GIT_COMMIT=unknown
PORT=8001

# Límites de admisión y tamaño del cuerpo.
MAX_UPLOAD_BYTES=67108864
MAX_CONCURRENCY=1
RETRY_AFTER_SECONDS=1

# Gunicorn: workers del master y backlog acotado.
WEB_CONCURRENCY=1
GUNICORN_BACKLOG=64

# Consul deshabilitado en local por defecto.
CONSUL_ENABLED=false
CONSUL_HTTP_ADDR=http://127.0.0.1:8500
CONSUL_HTTP_TOKEN=
CONSUL_HTTP_TIMEOUT=2
